{
  "name": "eep",
  "version": "0.1.0",
  "private": true,
  "description": "Engineering Evaluation Platform — reproducible evaluation infrastructure for AI-assisted software engineering.",
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "experiment:run": "npm run build && node --env-file=.env dist/experiments/runComparisonExperiment.js",
    "experiment:analyze": "npm run build && node dist/experiments/analyzeComparisonResults.js",
    "report:generate": "npm run build && node dist/experiments/generateReport.js",
    "dashboard:generate": "npm run build && node dist/experiments/generateDashboard.js",
    "demo:generate": "npm run build && node dist/experiments/generateDemoDashboard.js",
    "reproduce:smoke": "npm run build && node dist/experiments/runSmokeReproduction.js",
    "report:compare": "npm run build && node dist/experiments/compareIndependentRuns.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.9.0",
    "eslint": "^9.13.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "cross-spawn": "^7.0.6",
    "zod": "^4.6.4"
  }
}
